<Window x:Class="GestiCoop.Views.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#75869E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#C5D0DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Erreur" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EF5546"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#75869E"/>
            <Setter Property="BorderBrush" Value="#C5D0DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#205581" Padding="18,14">
            <TextBlock Text="{Binding Titre}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="NOM *"
                               Style="{StaticResource Libelle}"/>
                    <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ErreurNom}"
                               Style="{StaticResource Erreur}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PRÉNOM *"
                               Style="{StaticResource Libelle}"/>
                    <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ErreurPrenom}"
                               Style="{StaticResource Erreur}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="COURRIEL *"
                       Style="{StaticResource Libelle}"
                       Margin="0,18,0,6"/>

            <TextBox Text="{Binding Courriel, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox"
                           BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CourrielInvalide}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="#EF5546"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Text="{Binding ErreurCourriel}"
                       Style="{StaticResource Erreur}"/>

            <TextBlock Text="PROGRAMME *"
                       Style="{StaticResource Libelle}"
                       Margin="0,18,0,6"/>

            <ComboBox ItemsSource="{Binding Programmes}"
                      SelectedItem="{Binding Programme, Mode=TwoWay}"
                      Height="38"
                      Padding="8"
                      VerticalContentAlignment="Center"/>

            <TextBlock Text="{Binding ErreurProgramme}"
                       Style="{StaticResource Erreur}"/>

            <TextBlock Text="NUMÉRO D'ÉTUDIANT"
                       Style="{StaticResource Libelle}"
                       Margin="0,18,0,6"/>

            <Grid>
                <TextBox Text="{Binding NumeroEtudiant, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Optionnel"
                           Foreground="#75869E"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NumeroEtudiant}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Text="Format : 7 chiffres (ex. : 2024001)"
                       Foreground="#75869E"
                       FontSize="11"
                       Margin="0,6,0,0"/>

            <TextBlock Text="{Binding ErreurNumero}"
                       Style="{StaticResource Erreur}"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#C5D0DF"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        IsCancel="True"
                        Margin="0,0,8,0"/>

                <Button Content="Enregistrer"
                        Command="{Binding EnregistrerCommand}"
                        IsDefault="True"
                        Background="#EF7565"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>