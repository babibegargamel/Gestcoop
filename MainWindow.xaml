<Window x:Class="GestiCoop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestiCoop.Views"
        Title="GestiCoop — Gestion des stages coopératifs"
        Width="1150" Height="650"
        MinWidth="1050" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#24356C">
            <TextBlock Text="GestiCoop — Gestion des stages coopératifs"
                       Foreground="White"
                       Margin="16,0"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#293B77">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18">
                        <TextBlock Text="Abdnour Hanafi"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Coordonnateur"
                                   Foreground="#B8C4E5"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="GestiCoop"
                                   Foreground="White"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="18,25,0,3"/>

                        <TextBlock Text="Stages coopératifs"
                                   Foreground="#B8C4E5"
                                   Margin="18,0,0,35"/>

                        <TextBlock Text="PRINCIPAL"
                                   Foreground="#A7B5DA"
                                   FontSize="11"
                                   Margin="18,0,0,12"/>

                        <TextBlock Text="▦   Tableau de bord"
                                   Foreground="#DCE3F5"
                                   Margin="18,12"/>

                        <TextBlock Text="▣   Offres de stage"
                                   Foreground="#DCE3F5"
                                   Margin="18,12"/>

                        <Border Background="#40568F" Padding="18,12">
                            <TextBlock Text="●   Étudiants"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="▤   Candidatures"
                                   Foreground="#DCE3F5"
                                   Margin="18,12"/>

                        <TextBlock Text="▥   Entreprises"
                                   Foreground="#DCE3F5"
                                   Margin="18,12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <views:EtudiantsView Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>